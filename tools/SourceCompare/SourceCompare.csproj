<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compares two C# source trees at the level of TYPES and MEMBERS rather than text.

    Why not diff: one side is ILSpy output and the other is what a person wrote. Brace style,
    member order, `int` vs `Int32`, one-type-per-file vs several, `this.` qualification and
    collection-initialiser syntax all differ on every line, so a textual diff is 100% noise and
    says nothing about whether the two builds actually contain the same code.

    Roslyn rather than regex because the answer decides what gets patched: a missed member is a
    behaviour difference that ships.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>sourcecompare</AssemblyName>
    <RootNamespace>UW.Tools.SourceCompare</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
