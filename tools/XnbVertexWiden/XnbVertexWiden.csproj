<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Widens BlendWeight vertex elements from Color to Vector4 in compiled model XNBs.

    This is PORT DEVIATION 14 moved from run time to build time. The runtime version
    (UWGame/Port/SkinnedVertexCompat.cs) rebuilds each model's vertex buffers as they load, which
    works on MonoGame and CANNOT work on FNA at all - XNA's ModelMeshPart.VertexBuffer is
    read-only and MonoGame added the setter. Doing it to the data instead fixes every backend at
    once and lets the runtime shim be deleted.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>xnbvertexwiden</AssemblyName>
    <RootNamespace>UW.Tools.XnbVertexWiden</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\MgfxTranscode\XnbFile.cs" Link="Shared\XnbFile.cs" />
    <Compile Include="..\MgfxTranscode\Lz4DecoderStream.cs" Link="Shared\Lz4DecoderStream.cs" />
  </ItemGroup>
</Project>
