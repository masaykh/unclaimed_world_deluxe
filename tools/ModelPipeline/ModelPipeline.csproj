<Project Sdk="Microsoft.NET.Sdk">
  <!-- The studio's model processors (original_src/AnimationComponentPipeline and VehiclePipeline),
       built for the mgcb this repository installs (tools/build/36-build-fonts.sh,
       38-build-models.sh), so an FBX can be compiled into a model .xnb the game loads. mgcb loads
       this with /reference.

       Compiled against MonoGame's content pipeline package at the repository's pinned version
       (MonoGameVersion in Directory.Packages.props) - the same version as that mgcb, so the two
       agree - and compile-only: at run time the assembly lives inside mgcb, which brings its own
       copies. Not against mgcb's install folder, which exists only after a local content build:
       CI builds every tool for the dead-code gate and has none. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>UwModelPipeline</AssemblyName>
    <RootNamespace>Xclna.Xna.Animation.Content</RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Content.Pipeline" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Matrix, Vector3 and the rest: the pipeline package does not bring them to compile against. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
