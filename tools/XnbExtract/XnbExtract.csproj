<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads compiled .xnb assets back out: an inventory of what a content folder holds, and
       Texture2D assets decoded to PNG. Shares the container parser with MgfxTranscode rather than
       repeating it - one implementation of the XNB header, reader table and LZ4 path.

       No MonoGame reference on purpose: a texture is a format enum plus width, height and bytes,
       and reading that needs no graphics device, so this runs headless in a build or a script. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>xnbextract</AssemblyName>
    <RootNamespace>UW.Tools.XnbExtract</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\MgfxTranscode\XnbFile.cs" Link="Shared\XnbFile.cs" />
    <Compile Include="..\MgfxTranscode\Lz4DecoderStream.cs" Link="Shared\Lz4DecoderStream.cs" />
  </ItemGroup>
</Project>
