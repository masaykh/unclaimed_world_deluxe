+                    "declared at file scope. ShadowDusk binds each sampler to one texture by " +
+                    "name, so the shadowed name cannot be resolved unambiguously. Rename the " +
+                    "parameter.", _tokens[nameIdx]);
+            }
+
+            // tex1D through a sampler parameter would need its decay helper declared inside the
+            // function (the texture is a local now, not a global), which the span-substitution
+            // machinery cannot do. Say so rather than emitting a call to a helper that is not there.
+            if (_samplerLegacyIntrinsics.TryGetValue(paramName, out HashSet<string>? used) &&
