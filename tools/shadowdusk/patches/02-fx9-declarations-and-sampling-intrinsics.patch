+    }
+
+    /// <summary>
+    /// One round of the fixed point in <see cref="CollectSamplerParameterFunctions"/>: records
+    /// every sampler parameter that <paramref name="intrinsicSamplers"/> says is sampled through.
+    /// </summary>
+    private Result<Unit, FxParseError> ScanSamplerParameters(
+        HashSet<string> fileScopeSamplers, HashSet<string> intrinsicSamplers)
+    {
+        for (int i = 1; i < _tokens.Count; i++)
+        {
+            if (_tokens[i].Kind != TokenKind.Identifier ||
+                !LegacySamplerObjectTypes.Contains(_tokens[i].Text))
+                continue;
+
+            int nameIdx = NextCodeIndex(i + 1);
+            if (nameIdx >= _tokens.Count || _tokens[nameIdx].Kind != TokenKind.Identifier)
+                continue;
+
+            // Must sit in parameter position: the preceding code token is '(' or ','.
+            int prevIdx = PrevCodeIndex(i - 1);
+            if (prevIdx < 0 || _tokens[prevIdx].Kind is not (TokenKind.LParen or TokenKind.Comma))
+                continue;
+
+            // Only a parameter a legacy intrinsic actually samples through needs splitting —
+            // the same gate the file-scope sampler declarations use. A sampler parameter nothing
+            // samples through is left exactly as written: there is nothing to fix, and rewriting
+            // it would change a signature (and every call site) for no reason.
+            if (!intrinsicSamplers.Contains(_tokens[nameIdx].Text))
+                continue;
+
+            // Walk back to the parameter list's own '(', counting the top-level commas that
+            // precede this parameter — that count IS its argument index.
+            int argIndex = 0;
+            int depth = 0;
+            int open = -1;
+            for (int j = prevIdx; j >= 0; j--)
+            {
+                TokenKind k = _tokens[j].Kind;
+                if (k == TokenKind.RParen) { depth++; continue; }
+                if (k == TokenKind.LParen)
+                {
+                    if (depth == 0) { open = j; break; }
+                    depth--;
+                    continue;
+                }
+                if (k == TokenKind.Comma && depth == 0) argIndex++;
+            }
+            if (open < 0)
+                continue;
+
+            int funcIdx = PrevCodeIndex(open - 1);
+            if (funcIdx < 0 || _tokens[funcIdx].Kind != TokenKind.Identifier)
+                continue;
+
+            string funcName = _tokens[funcIdx].Text;
+            string paramName = _tokens[nameIdx].Text;
+
+            // A parameter shadowing a FILE-SCOPE sampler of the same name would make the binding
+            // map ambiguous: the map is keyed by name, so the main loop's declaration would
+            // overwrite this parameter's entry and the body's tex2D would silently sample the
+            // global texture through the parameter's sampler. Refuse rather than guess.
+            //
+            // Two FUNCTIONS sharing a parameter name is not that, and is entirely ordinary — they
+            // are separate scopes, both resolve to the same synthesized name, and each declares
+            // its own texture parameter. It must not be flagged.
+            if (fileScopeSamplers.Contains(paramName))
+            {
+                return Fail<Unit>(FxParseErrorCode.UnsupportedLegacyIntrinsic,
