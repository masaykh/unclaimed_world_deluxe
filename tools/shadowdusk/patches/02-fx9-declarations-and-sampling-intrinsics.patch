+            {
+                return Fail<Unit>(FxParseErrorCode.UnsupportedLegacyIntrinsic,
+                    $"The sampler parameter '{paramName}' of '{funcName}' is sampled with a tex1D " +
+                    "intrinsic. tex1D lowers through a generated helper bound to the sampler's " +
+                    "texture, which only exists for a sampler declared at file scope. Sample it " +
+                    "with tex2D (a 1D texture is one texel tall), or pass the texture separately.",
+                    _tokens[nameIdx]);
+            }
