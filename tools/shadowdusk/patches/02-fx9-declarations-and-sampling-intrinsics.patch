+    private static string Tex1DHelperName(string samplerName) => samplerName + "_SDTex1D";
+    private static string Tex1DGradHelperName(string samplerName) => samplerName + "_SDTex1DGrad";
+
+    /// <summary>
+    /// HLSL for the tex1D-family helpers <paramref name="samplerName"/> needs, appended to its
+    /// rewritten declaration (which is where both the sampler and its texture are in scope).
+    /// Returns <see cref="string.Empty"/> when no tex1D call reaches this sampler — the
+    /// overwhelmingly common case, where nothing is emitted at all.
+    /// </summary>
+    /// <remarks>
+    /// <para>
+    /// <c>tex1D</c> has no modern counterpart because D3D10+ dropped the notion of a sampler
+    /// whose coordinate is narrower than its resource. A 1D sample is not a distinct operation
+    /// in the GL/SM4 world: it is a 2D sample of a texture one texel tall, and the second
+    /// coordinate is don't-care. That is also exactly what the D3D9 stack did — the application
+    /// binds an ordinary 2D texture to the slot (this game's <c>OverlayGradient</c> is a 76x1
+    /// <c>Texture2D</c>), and fxc replicates the scalar across the coordinate register.
+    /// MojoShader lowers the same construct the same way, decaying the sampler to
+    /// <c>sampler2D</c> and emitting <c>texture2D(s, coord.xx)</c> — verified against an
+    /// mgfxc-built golden of this game's <c>skinFX</c>.
+    /// </para>
+    /// <para>
+    /// So the lowering is <c>T.Sample(s, float2(t, 0))</c>: 0 is the canonical don't-care for
+    /// the dimension the intrinsic declines to address. Emitting it as a per-sampler helper
+    /// rather than rewriting the call's argument list keeps the call-site edit a pure
+    /// identifier swap, which is all the span-substitution machinery here can do safely.
+    /// </para>
+    /// </remarks>
+    private string BuildSampleHelpers(string samplerName, string textureName)
+    {
+        if (!_samplerLegacyIntrinsics.TryGetValue(samplerName, out HashSet<string>? intrinsics))
+            return string.Empty;
