+            string texture = SynthTextureName(paramName);
+            LegacyTextureKind kind = KindOfSampler(paramName);
+            _samplerTextureBindings[paramName] = texture;
+            _textureKinds[texture] = kind;
+
+            if (!_samplerParamFunctions.TryGetValue(funcName, out List<SamplerParameter>? list))
+                _samplerParamFunctions[funcName] = list = new List<SamplerParameter>();
+            list.Add(new SamplerParameter(argIndex, paramName));
+
+            _samplerParamFunctionDefNames.Add(funcIdx);
+
+            int spanStart = _tokenCharOffset[i];
+            int spanEnd = _tokenCharOffset[nameIdx] + _tokens[nameIdx].Text.Length;
+            _samplerParamDeclRewrites.Add((spanStart, spanEnd,
+                $"{ResourceTypeOf(kind)} {texture}, SamplerState {paramName}"));
+        }
+
+        return Result<Unit, FxParseError>.Ok(Unit.Value);
+    }
+
+    /// <summary>
+    /// Adds every sampler passed at a sampler-parameter position of a known sampler-taking
+    /// function to <paramref name="intrinsicSamplers"/>, and propagates the parameter's
+    /// dimension to it. Passing a sampler to such a function is sampling through it: without
+    /// this its declaration is erased as unused, so no texture is bound and the call site has
+    /// nothing to pass.
+    /// </summary>
+    private void CollectSamplerArgumentsAtCallSites(HashSet<string> intrinsicSamplers)
+    {
+        for (int i = 0; i < _tokens.Count; i++)
+        {
+            if (_tokens[i].Kind != TokenKind.Identifier ||
+                _samplerParamFunctionDefNames.Contains(i) ||
+                !_samplerParamFunctions.TryGetValue(_tokens[i].Text, out List<SamplerParameter>? ps))
+                continue;
+
+            int lparen = NextCodeIndex(i + 1);
+            if (lparen >= _tokens.Count || _tokens[lparen].Kind != TokenKind.LParen)
+                continue;
+
+            foreach (SamplerParameter sp in ps)
+            {
+                if (!TryFindCallArgumentIdentifierAt(lparen, sp.ArgIndex, out int argIdx))
+                    continue;
+
+                string arg = _tokens[argIdx].Text;
+                intrinsicSamplers.Add(arg);
+
+                // The callee states the dimension; the caller's declaration has to agree, or its
+                // texture would be synthesized as the wrong resource type.
+                if (!_samplerSampleKinds.ContainsKey(arg) &&
+                    _samplerSampleKinds.TryGetValue(sp.Name, out LegacyTextureKind kind))
+                    _samplerSampleKinds[arg] = kind;
+            }
