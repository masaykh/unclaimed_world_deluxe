+    ///   float4 GetOutlineColor(sampler s, float2 uv)
+    ///     -> float4 GetOutlineColor(Texture2D s_SDTexture, SamplerState s, float2 uv)
+    ///   GetOutlineColor(TextureSampler, uv)
+    ///     -> GetOutlineColor(BasicTexture, TextureSampler, uv)
+    /// </code>
+    /// <para>
+    /// A sampler parameter is recognized WITHOUT needing to detect function definitions: the type
+    /// keyword sits immediately after a '(' or a ',', which is a parameter position and nothing
+    /// else (a call passes an expression, never <c>Type ident</c>). Walking back from there to the
+    /// parameter list's own '(' gives the function name and the parameter's index.
+    /// </para>
+    /// </remarks>
+    private Result<Unit, FxParseError> CollectSamplerParameterFunctions()
+    {
+        // Pass 1: the names declared as samplers at FILE SCOPE. A sampler-typed token pair is a
+        // parameter exactly when a '(' or ',' precedes it, so the same discrimination, inverted,
+        // identifies the declarations — needed for the shadowing guard below, because file-scope
+        // declarations are not processed until the main loop.
+        var fileScopeSamplers = new HashSet<string>(StringComparer.Ordinal);
+        for (int i = 0; i < _tokens.Count; i++)
+        {
+            if (_tokens[i].Kind != TokenKind.Identifier ||
+                !LegacySamplerObjectTypes.Contains(_tokens[i].Text))
+                continue;
+
+            int n = NextCodeIndex(i + 1);
+            if (n >= _tokens.Count || _tokens[n].Kind != TokenKind.Identifier)
+                continue;
+
+            int p = PrevCodeIndex(i - 1);
+            if (p < 0 || _tokens[p].Kind is not (TokenKind.LParen or TokenKind.Comma))
+                fileScopeSamplers.Add(_tokens[n].Text);
+        }
+
+        // Passing a sampler to one of these functions IS sampling through it, so the argument
+        // has to join the "sampled through a legacy intrinsic" set — otherwise its declaration is
+        // erased as unused and no texture binding is recorded, and the call site has nothing to
+        // pass. Which arguments those are is only known once the callees are known, and a callee
+        // is only recognized once its own parameter is known to be sampled — so iterate to a fixed
+        // point. One round finds the directly-sampled cases, the next those passed on from them.
+        // The set only ever grows and is bounded by the number of identifiers, so this terminates.
+        var intrinsicSamplers = new HashSet<string>(_legacyIntrinsicSamplers, StringComparer.Ordinal);
+        while (true)
+        {
+            _samplerParamFunctions.Clear();
+            _samplerParamFunctionDefNames.Clear();
+            _samplerParamDeclRewrites.Clear();
+
+            Result<Unit, FxParseError> scan = ScanSamplerParameters(fileScopeSamplers, intrinsicSamplers);
+            if (scan.IsFailure)
