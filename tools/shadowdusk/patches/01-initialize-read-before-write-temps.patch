+            if (pos + length > bytecode.Length)
+                return bytecode;
+            Append(output, bytecode, pos, length);
+            pos += length;
+        }
+
+        Append(output, bytecode, pos, bytecode.Length - pos);
+        return output.ToArray();
+    }
