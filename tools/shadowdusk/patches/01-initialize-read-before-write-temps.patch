+                // and a register both read and written by the SAME instruction still counts as
+                // a read - which matches how MojoShader parses it.
+                int firstSource = hasDest ? 1 : 0;
+                for (int i = firstSource; i < operandTokens; i++)
+                {
+                    uint p = ReadU32(bytecode, pos + i * 4);
+                    if ((p & ParamTokenBit) == 0)
+                        continue;
+                    int regType = (int)(((p >> 28) & 0x7) | (((p >> 11) & 0x3) << 3));
+                    if (regType != 0 /* D3DSPR_TEMP */)
+                        continue;
+                    int reg = (int)(p & 0x7FF);
+                    if (!written.Contains(reg) && !fixes.Exists(f => f.Register == reg))
+                        fixes.Add((instructionStart, reg));
+                }
