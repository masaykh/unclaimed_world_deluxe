+            // Opcodes with no destination operand. Everything else in SM2+ writes operand 0.
+            bool hasDest = opcode is not (0x00 or 0x19 or 0x1A or 0x1B or 0x1C or 0x1D or 0x1E
+                                          or 0x26 or 0x27 or 0x28 or 0x29 or 0x2A or 0x2B
+                                          or 0x2C or 0x2D);
