+                    {
+                        int regType = (int)(((dest >> 28) & 0x7) | (((dest >> 11) & 0x3) << 3));
+                        if (regType == 0)
+                            written.Add((int)(dest & 0x7FF));
+                    }
+                }
+            }
+
+            pos += operandTokens * 4;
+        }
+
+        if (fixes.Count == 0)
+            return bytecode;
+
+        // ---- rebuild, inserting each init immediately before the instruction that reads it.
+        var output = new List<byte>(bytecode.Length + fixes.Count * 16);
+        Append(output, bytecode, 0, 4);
+        bool prologueDone = false;
+
+        pos = 4;
+        while (pos + 4 <= bytecode.Length)
+        {
+            uint token = ReadU32(bytecode, pos);
+            if (token == EndToken)
+                break;
+
+            int length;
+            if ((token & 0xFFFF) == CommentOpcode && (token & ParamTokenBit) == 0)
+            {
+                length = 4 + (int)((token >> 16) & 0x7FFF) * 4;
+            }
+            else
+            {
+                length = 4 + (int)((token >> 24) & 0xF) * 4;
+            }
+
+            // Hoisted to the PROLOGUE, not emitted before each offending read.
+            //
+            // MojoShader's check is linear, but execution is not: inside a loop, a register
+            // written at the end of one iteration is legitimately read at the start of the next,
+            // and the linear scan flags that as uninitialised. Initialising immediately before
+            // the read would then re-zero the register on every iteration and destroy exactly the
+            // accumulator the shader was carrying. Doing it once, before any real instruction,
+            // satisfies the validator and cannot clobber a value the shader computed.
+            if (!prologueDone && IsRealInstruction(token))
+            {
+                prologueDone = true;
+                foreach (int reg in fixes.Select(f => f.Register).Distinct())
+                {
+                    WriteU32(output, 0x0300_0000u | OpSub);
+                    WriteU32(output, ParamTokenBit | FullWritemask | (uint)reg);
+                    WriteU32(output, ParamTokenBit | ConstRegTypeBits | IdentitySwizzle);
+                    WriteU32(output, ParamTokenBit | ConstRegTypeBits | IdentitySwizzle);
+                }
+            }
