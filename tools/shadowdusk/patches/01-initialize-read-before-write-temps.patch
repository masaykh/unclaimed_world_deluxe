+    private static byte[] InitializeReadBeforeWriteTemps(byte[] bytecode, int major)
+    {
+        const int OpSub = 0x03;
+        const uint ConstRegTypeBits = 0x2000_0000; // D3DSPR_CONST in bits [30:28]
+        const uint IdentitySwizzle = 0x00E4_0000;
+
+        var written = new HashSet<int>();
+        var fixes = new List<(int Offset, int Register)>();
+
+        int pos = 4;
+        while (pos + 4 <= bytecode.Length)
+        {
+            uint token = ReadU32(bytecode, pos);
+            if (token == EndToken)
+                break;
+
+            if ((token & 0xFFFF) == CommentOpcode && (token & ParamTokenBit) == 0)
+            {
+                pos += 4 + (int)((token >> 16) & 0x7FFF) * 4;
+                continue;
+            }
+
+            int opcode = (int)(token & 0xFFFF);
+            int operandTokens = (int)((token >> 24) & 0xF);
+            int instructionStart = pos;
+            pos += 4;
+
+            if (pos + operandTokens * 4 > bytecode.Length)
+                return bytecode; // truncated tail - do not guess
+
+            // Declarations and literal definitions carry payloads, not operands.
+            if (opcode is OpDcl or OpDef or OpDefI or OpDefB)
+            {
+                pos += operandTokens * 4;
