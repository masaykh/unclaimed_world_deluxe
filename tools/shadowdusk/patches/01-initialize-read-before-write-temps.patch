+    /// <summary>
+    /// Fix #4: gives a defined value to any temp register that is READ before it is ever
+    /// WRITTEN, by inserting <c>sub rN, c0, c0</c> immediately before the first such read.
+    ///
+    /// MojoShader validates this linearly, in token order (mojoshader.c, in the destination
+    /// operand walk):
+    ///
+    ///     if ((info-&gt;regtype == REG_TYPE_TEMP) &amp;&amp; (reg) &amp;&amp; (!reg-&gt;written))
+    ///         failf(ctx, "Temp register r%d used uninitialized", info-&gt;regnum);
+    ///
+    /// so a stream vkd3d emits where rN is sourced before any instruction names it as a
+    /// destination is rejected outright — "MOJOSHADER_compileEffect Error: Temp register r1
+    /// used uninitialized" — even though the D3D9 runtime never enforced it and fxc-era
+    /// shaders relied on that. Observed on real content: Unclaimed World's multiTex (r1) and
+    /// Billboard (r3), both of which initialise correctly at the HLSL level.
+    ///
+    /// <c>sub rN, c0, c0</c> rather than a mov from a literal: it needs no new <c>def</c>
+    /// constant (which could collide with a slot the effect's constant table already uses)
+    /// and yields zero whatever c0 holds, including when c0 is unbound and reads as zero.
+    /// The value itself cannot change behaviour that was defined before — the register had no
+    /// defined contents at that point by construction.
+    ///
+    /// Conservative by design: an instruction using relative addressing is left alone rather
+    /// than mis-parsed, and anything that cannot be walked cleanly returns the input
+    /// untouched.
+    /// </summary>
+    /// <summary>
+    /// Whether a token starts an instruction that may appear after the declaration prologue.
+    /// dcl / def / defi / defb must all precede real work in SM2+, so the first token that is
+    /// none of them marks where an inserted initialiser is legal.
+    /// </summary>
+    private static bool IsRealInstruction(uint token)
+    {
+        if ((token & 0xFFFF) == CommentOpcode && (token & ParamTokenBit) == 0) return false;
+        int opcode = (int)(token & 0xFFFF);
+        return opcode is not (OpDcl or OpDef or OpDefI or OpDefB);
+    }
